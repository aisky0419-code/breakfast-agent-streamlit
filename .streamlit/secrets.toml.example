# 機密設定的範本。
#   本機：複製成 .streamlit/secrets.toml 再填值（secrets.toml 已列在 .gitignore）
#   雲端：Streamlit Cloud → App settings → Secrets，把填好的內容整段貼上
#
# TOML 的字串一定要加引號；這些 key 都要放在最上層（不要包進 [區段]）。

OPENAI_API_KEY = "sk-..."
OPENAI_MODEL = "gpt-6-luna"
# GUARDRAIL_MODEL = ""

# Aiven MySQL（到 Aiven 主控台的 Connection information 複製）
DB_HOST = "xxxx.aivencloud.com"
DB_PORT = "12345"
DB_USER = "avnadmin"
DB_PASSWORD = ""
